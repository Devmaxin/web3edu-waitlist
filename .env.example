# Copy to .env.local for local development, and configure the same keys in Vercel.
# EVERY value below is a PLACEHOLDER. Never commit real values: .env files are gitignored.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project Settings → API. These two are safe-ish client keys (anon is public).
NEXT_PUBLIC_SUPABASE_URL=https://SUPABASE_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUPABASE_ANON_KEY_PLACEHOLDER
# Service role key: SERVER-ONLY. Grants full DB access — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=SUPABASE_SERVICE_ROLE_KEY_PLACEHOLDER

# ── App crypto ───────────────────────────────────────────────────────────────
# 32+ random bytes, base64. Derives pass/QR tokens, signs referral and unsubscribe links.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_KEY=BASE64_RANDOM_32_BYTES_PLACEHOLDER

# Public base URL, no trailing slash. Used for every link in emails, QR codes and share links.
NEXT_PUBLIC_SITE_URL=https://BASE_URL_PLACEHOLDER

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=RESEND_API_KEY_PLACEHOLDER
MAIL_FROM_NAME=Web3Edu
MAIL_FROM_ADDRESS=hello@WAITLIST_SENDER_DOMAIN_PLACEHOLDER
MAIL_REPLY_TO=
# Svix signing secret from the Resend dashboard webhook page (starts with whsec_).
RESEND_WEBHOOK_SECRET=whsec_PLACEHOLDER_FROM_RESEND_WEBHOOK_PAGE

# ── Scheduled work ───────────────────────────────────────────────────────────
# Header value required by /api/cron/email (Vercel Cron sends it as Authorization: Bearer).
CRON_SECRET=LONG_RANDOM_STRING_PLACEHOLDER

# ── Contact addresses shown in the footer / privacy page ─────────────────────
SUPPORT_EMAIL=SUPPORT_EMAIL_PLACEHOLDER
PRIVACY_EMAIL=PRIVACY_EMAIL_PLACEHOLDER
